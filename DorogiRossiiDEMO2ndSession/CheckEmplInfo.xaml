<Window x:Class="DorogiRossiiDEMO2ndSession.CheckEmplInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DorogiRossiiDEMO2ndSession"
        mc:Ignorable="d"
        Title="CheckEmplInfo" Height="800" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Background="LightGray">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Label Content="Фамилия"/>
            <TextBox Text="{Binding EmployeeOnPage.LastName}" Grid.Column="1" />
            <Label Content="Имя" Grid.Row="1"/>
            <TextBox Text="{Binding EmployeeOnPage.FirstName}" Grid.Row="1" Grid.Column="1"/>
            <Label Content="Отчество" Grid.Row="2"/>
            <TextBox Text="{Binding EmployeeOnPage.Patronymic}" Grid.Row="5" Grid.Column="1"/>
        </Grid>

        <Label Content="Мобильный телефон" Grid.Row="1"/>
        <TextBox Text="{Binding EmployeeOnPage.Phone}" Grid.Row="2"/>
        <StackPanel Orientation="Horizontal" Grid.Row="3">
            <Label Content="День рождения" />
            <DatePicker SelectedDate="{Binding EmployeeOnPage.Birthday}" />
        </StackPanel>
        <Label Content="Структурное подразделение:" Grid.Row="4"/>
        <Label Grid.Row="5" Content="{Binding EmployeeOnPage.IdDepartmentNavigation.Title}"/>
        <Label Content="Должность:" Grid.Row="6"/>
        <Label Grid.Row="7" Content="{Binding EmployeeOnPage.IdRoleNavigation.Title}" />
        <Label Content="Непосредственный руководитель" Grid.Row="8"/>
        <ComboBox Grid.Row="9" ItemsSource="{Binding EmployeesFromSameDep}" DisplayMemberPath="FIO"/>
        <Label Content="Помощник" Grid.Row="10"/>
        <ComboBox Grid.Row="11" ItemsSource="{Binding EmployeesFromSameDep}" DisplayMemberPath="FIO"/>
        <Label Content="Рабочий телефон" Grid.Row="12"/>
        <TextBox Text="{Binding EmployeeOnPage.OfficePhone}" Grid.Row="13"/>
        <Label Content="Электронная почта" Grid.Row="14"/>
        <TextBox Text="{Binding EmployeeOnPage.Email }" Grid.Row="15"/>
        <StackPanel Grid.Row="16" Orientation="Horizontal">
            <Label Content="Кабинет" />
            <TextBox Text="{Binding EmployeeOnPage.IdOfficeNavigation.Number}"/>
        </StackPanel>
        <Label Content="Прочая информация" Grid.Row="17"/>
        <TextBox Text="{Binding EmployeeOnPage.Description}" Grid.Row="18"/>

        <Grid Grid.Column="1" Grid.RowSpan="100">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ToggleButton Content="Прошедшие"/>
            <ToggleButton Content="Текущие" Grid.Column="1" />
            <ToggleButton Content="Будущие" Grid.Column="2"/>
            <Button x:Name="edit" Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="55" Height="60" >
                <Button.Background>
                    <ImageBrush ImageSource="/edit.png"/>
                </Button.Background>
            </Button>

        </Grid>
    </Grid>
</Window>
