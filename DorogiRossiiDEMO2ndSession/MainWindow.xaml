<Window x:Class="DorogiRossiiDEMO2ndSession.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DorogiRossiiDEMO2ndSession"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Icon="Logo.png">
    <Window.Resources>
        <ControlTemplate x:Key="Template" TargetType="Label">
            <Border BorderBrush="White" BorderThickness="2" CornerRadius="3"
                    TextBlock.Foreground="White">
                <Label Content="Организационная структура"  Background="White" Width="400" />
            </Border>
        </ControlTemplate>
    </Window.Resources>
    <Grid Background="LightGray">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Background="LightGreen">
            <Image Source="Logo.png" Height="50"/>
            <Label Template="{StaticResource Template}" Content="Организационная структура" HorizontalAlignment="Center" Margin="5" Background="White" Width="400"   Height="30"/>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Visible" Grid.Row="1">
            <Canvas x:Name="diagram" >
            </Canvas>
        </ScrollViewer>

        <ListBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CurrentDepartmentEmployees}" SelectedItem="{Binding SelectedEmpl}" MouseDoubleClick="CheckInfoSelectedEmpl">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid  Background="LightGreen" MinWidth="400">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding IdDepartmentNavigation.Title}"/>
                                <TextBlock Text=" - "/>
                                <TextBlock Text="{Binding IdRoleNavigation.Title}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding FIO}" Grid.Row="1" FontSize="14"/>
                                <TextBlock Text="{Binding Contacts}" Grid.Row="2"/>
                            <TextBlock Text="{Binding IdOfficeNavigation.Number}" Grid.Row="3"/> 
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
